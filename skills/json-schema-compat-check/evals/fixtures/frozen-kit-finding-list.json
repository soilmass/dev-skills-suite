{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.local/shapes/finding-list.schema.json",
  "title": "finding-list",
  "description": "SARIF-compatible list of findings produced by an audit/finder-type skill (SDS-C-031, Standards-First Rule). A zero-entry `results` array is a valid, complete instance, not an error or omission (SDS-C-033, Null Object Requirement).",
  "type": "object",
  "required": ["version", "runs"],
  "properties": {
    "version": {
      "const": "sds-finding-list-1.0"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool", "results"],
        "properties": {
          "tool": {
            "type": "object",
            "required": ["driver"],
            "properties": {
              "driver": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The skill's name, e.g. 'dependency-audit'."
                  },
                  "version": { "type": "string" }
                }
              }
            }
          },
          "results": {
            "type": "array",
            "description": "MAY be empty. An empty array here is the correct, complete representation of 'nothing found' — not null, not an omitted field.",
            "items": {
              "type": "object",
              "required": ["ruleId", "level", "message", "locations"],
              "properties": {
                "ruleId": {
                  "type": "string",
                  "description": "Stable identifier for the kind of finding. Prefer an external identifier where one exists (e.g. an OSV vulnerability ID) over an invented one."
                },
                "level": {
                  "enum": ["error", "warning", "info", "hint"]
                },
                "message": {
                  "type": "object",
                  "required": ["text"],
                  "properties": {
                    "text": { "type": "string" }
                  }
                },
                "locations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "physicalLocation": {
                        "type": "object",
                        "properties": {
                          "artifactLocation": {
                            "type": "object",
                            "properties": {
                              "uri": { "type": "string" }
                            }
                          },
                          "region": {
                            "type": "object",
                            "properties": {
                              "startLine": { "type": "integer" }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "fixes": {
                  "type": "array",
                  "description": "Optional suggested-fix objects. First-class, not folded into message.text (SDS-C-031).",
                  "items": {
                    "type": "object",
                    "properties": {
                      "description": {
                        "type": "object",
                        "properties": { "text": { "type": "string" } }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
