{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example/order-placed/v2",
 "type": "object",
 "required": [
  "order_id",
  "status",
  "currency",
  "trace_id"
 ],
 "properties": {
  "order_id": {
   "type": "string"
  },
  "status": {
   "type": "string",
   "enum": [
    "open",
    "paid",
    "refunded"
   ]
  },
  "placed_at": {
   "type": "string"
  },
  "currency": {
   "type": "string"
  },
  "total": {
   "type": "integer",
   "maximum": 100000
  },
  "customer": {
   "$ref": "#/$defs/Customer"
  },
  "lines": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "sku": {
      "type": "string",
      "pattern": "^sku-"
     },
     "qty": {
      "type": "integer",
      "minimum": 1
     }
    }
   },
   "minItems": 1
  },
  "trace_id": {
   "type": "string"
  }
 },
 "$defs": {
  "Customer": {
   "type": "object",
   "properties": {
    "id": {
     "type": [
      "integer",
      "string"
     ]
    },
    "email": {
     "type": "string",
     "format": "email"
    }
   }
  }
 },
 "additionalProperties": false
}