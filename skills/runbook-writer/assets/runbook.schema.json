{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.local/skills/runbook-writer/runbook.schema.json",
  "title": "runbook",
  "description": "runbook-writer's own intermediate shape (SDS-S-080, a per-skill asset, not a family shape): the specification the Decide stage composes and scripts/render_runbook.py renders. Every step carries what to do, how to verify it worked, and what to do if it did not.",
  "type": "object",
  "required": ["title", "purpose", "trigger", "preconditions", "steps", "rollback", "escalation"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "trigger": { "type": "string", "minLength": 1 },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["do", "verify", "ifFails"],
        "properties": {
          "do": { "type": "string", "minLength": 1 },
          "verify": { "type": "string" },
          "ifFails": { "type": "string" }
        }
      }
    },
    "rollback": { "type": "string", "minLength": 1 },
    "escalation": {
      "type": "object",
      "required": ["who", "when"],
      "properties": { "who": { "type": "string" }, "when": { "type": "string", "minLength": 1 } }
    },
    "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
