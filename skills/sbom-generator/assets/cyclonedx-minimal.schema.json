{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.local/skills/sbom-generator/cyclonedx-minimal.schema.json",
  "title": "cyclonedx-minimal",
  "description": "A deliberately small SUBSET of the official CycloneDX 1.5 JSON schema (ECMA-424): the fields this skill emits and a consumer such as license-compliance-check relies on. It is a per-skill asset (SDS-S-080), not a family shape, and not a substitute for validating against the official schema, which references two further schemas (SPDX license ids, JSF signatures) and is therefore not bundled here.",
  "type": "object",
  "required": ["bomFormat", "specVersion", "version", "components"],
  "properties": {
    "bomFormat": { "const": "CycloneDX" },
    "specVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "serialNumber": { "type": "string", "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$" },
    "metadata": {
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "tools": { "type": "array" },
        "component": { "type": "object", "required": ["type", "name"] }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name", "version", "purl"],
        "properties": {
          "type": { "enum": ["application", "framework", "library", "container", "operating-system", "device", "firmware", "file"] },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "purl": { "type": "string", "pattern": "^pkg:[a-z]+/" },
          "licenses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "expression": { "type": "string" },
                "license": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } }
              }
            }
          },
          "properties": {
            "type": "array",
            "items": { "type": "object", "required": ["name", "value"], "properties": { "name": { "type": "string" }, "value": { "type": "string" } } }
          }
        }
      }
    }
  }
}
